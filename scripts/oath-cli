#!/usr/bin/env python3
"""Cloud CLI client. Credentials exist only in the execution environment."""

import hashlib
import json
import os
import sys
import time
import uuid
from pathlib import Path
from urllib.parse import urlsplit
from urllib.request import HTTPRedirectHandler, Request, build_opener


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        raise ValueError("CLI redirects are not allowed")


def call(path, payload=None):
    base = os.environ.get("OATH_CLI_SERVER", "").rstrip("/")
    parsed = urlsplit(base)
    if (
        parsed.username
        or parsed.password
        or parsed.query
        or parsed.fragment
        or (
            parsed.scheme != "https"
            and not (
                parsed.scheme == "http"
                and (
                    parsed.hostname in {"127.0.0.1", "localhost", "::1"}
                    or os.environ.get("OATH_CLI_INTERNAL_HTTP") == "1"
                )
            )
        )
    ):
        raise ValueError("OATH_CLI_SERVER must use HTTPS (HTTP is allowed on loopback only)")
    data = json.dumps(payload).encode() if payload is not None else None
    req = Request(
        base + path,
        data=data,
        headers={
            "Authorization": "Bearer " + os.environ.get("OATH_CLI_TOKEN", ""),
            "Content-Type": "application/json",
        },
    )
    with build_opener(NoRedirect()).open(req, timeout=10) as response:
        body = response.read(2 * 1024 * 1024 + 1)
        if len(body) > 2 * 1024 * 1024:
            raise ValueError("CLI result too large; read the stored detail in chunks")
        return json.loads(body)


def print_json(value):
    print(json.dumps(value, ensure_ascii=False))


def main(argv):
    if argv == ["--version"]:
        print(hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
        return 0
    if not argv or argv[0] in {"help", "--help"}:
        catalog = call("/cli/tools")
        if len(argv) > 1:
            catalog = {"commands": [d for d in catalog["commands"] if d["name"] == argv[1]]}
        print_json(catalog)
        return 0
    if argv[0] == "status":
        print_json(call("/cli/status", {"invocation_id": argv[1]}))
        return 0
    name, arguments, request_id, detached = argv[0], {}, uuid.uuid4().hex, False
    wait = 12.0
    args = iter(argv[1:])
    for arg in args:
        if arg == "--async":
            detached = True
        elif arg == "--request-id":
            request_id = next(args)
        elif arg == "--wait":
            wait = min(60, max(0, float(next(args))))
        elif arg == "--json":
            raw = next(args)
            arguments.update(json.load(sys.stdin) if raw == "-" else json.loads(raw))
        elif arg.startswith("--"):
            key, sep, value = arg[2:].partition("=")
            if not sep:
                value = next(args)
            try:
                arguments[key.replace("-", "_")] = json.loads(value)
            except ValueError:
                arguments[key.replace("-", "_")] = value
        else:
            raise ValueError("Use --json or named --argument values")
    result = call(
        "/cli/invoke",
        {"name": name, "arguments": arguments, "request_id": request_id, "async": detached},
    )
    if detached:
        print_json(result)
        return 0
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        status = call("/cli/status", {"invocation_id": result["invocation_id"]})
        if status["status"] == "waiting_approval":
            call("/cli/detach", {"invocation_id": result["invocation_id"]})
            print_json(status)
            return 1
        if status["status"] in {"succeeded", "failed", "timeout", "cancelled", "outcome_unknown"}:
            print_json(status)
            return 0 if status["status"] == "succeeded" else 1
        time.sleep(0.25)
    call("/cli/detach", {"invocation_id": result["invocation_id"]})
    print_json({**result, "status": "pending", "continuation": "event"})
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (KeyboardInterrupt, BrokenPipeError):
        raise SystemExit(130) from None
    except Exception as exc:
        # Do not print credentials, request headers or arbitrary HTTP response bodies.
        print("CLI request failed: " + type(exc).__name__, file=sys.stderr)
        raise SystemExit(2) from None
