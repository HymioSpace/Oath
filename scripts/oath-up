#!/usr/bin/env bash
# 完整启动：旧的先收干净，再保证 Redis 在跑，最后起 biz（进程组组长）。
#
# manager 在 biz 进程里，agent 与 supervisor 是它按 scope 现拉的 —— 这里只需要起一个
# 进程。scope 的进程等 create_session 才出现。
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/oath-common.sh"

cd "$OATH_ROOT"
oath_load_config
PYTHON="$(oath_python)"

oath_say "收掉上一轮"
oath_stop_biz

oath_say "确认中间件"
oath_start_redis

if "$PYTHON" "$OATH_ENV" listening 127.0.0.1 "$HTTP_PORT"; then
    oath_die "$HTTP_PORT 上已经有东西在听 —— 不是 Oath 的话先让开，或改 oath.toml 的 http_port"
fi

mkdir -p "$RUN_DIR"
oath_say "起 biz"
# setsid + exec：biz 变成自己那个进程组的组长，manager 拉起的 agent 与 supervisor 都跟着它。
# exec 让 pid 不变 —— pidfile 记的就是 biz 自己。
#
# **setsid 失败就让它炸。** 它失败说明这进程已经是组长，biz 就不是独立会话；那样
# oath-down 的整组收尾会把不该收的进程一起收掉。宁可起不来，也不要带着这个隐患跑。
"$PYTHON" -c 'import os, sys
os.setsid()
os.execv(sys.argv[1], sys.argv[1:])' \
    "$PYTHON" -m bootstrap.biz.process --config "$OATH_CONFIG" \
    >>"$LOG_FILE" 2>&1 </dev/null &
BIZ_PID=$!

if ! "$PYTHON" "$OATH_ENV" wait 127.0.0.1 "$HTTP_PORT" 20; then
    echo "biz 没在 20s 内监听 ${HTTP_PORT}，日志尾部：" >&2
    tail -n 30 "$LOG_FILE" >&2 || true
    exit 1
fi

# 端口起来了，setsid 一定已经跑过 —— 这时候读 pgid 才不会有竞态。
# pid 与 pgid 都记：biz 被 kill -9 之后 pid 查不到了，组还在，组里那才是能认出来的线索。
BIZ_PGID="$(ps -o pgid= -p "$BIZ_PID" 2>/dev/null | tr -d ' ' || true)"
echo "$BIZ_PID ${BIZ_PGID:-}" >"$PID_FILE"
[ "$BIZ_PGID" = "$BIZ_PID" ] || oath_say "注意：pgid ($BIZ_PGID) 与 pid 不一致，关闭时只能逐个进程收"

oath_say "Oath 起来了：http://$HTTP_PORT   （pid ${BIZ_PID}，日志 ${LOG_FILE}）"
oath_say "关掉它：scripts/oath-down"
