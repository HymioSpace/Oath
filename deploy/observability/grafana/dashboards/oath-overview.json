{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "RPC p95 by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(oath_rpc_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue and worker wait p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oath_queue_publish_delay_seconds_bucket[5m])))",
          "legendFormat": "broker publish"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oath_queue_to_buffer_seconds_bucket[5m])))",
          "legendFormat": "queue to buffer"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oath_buffer_wake_delay_seconds_bucket[5m])))",
          "legendFormat": "buffer to claim"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model TTFT p50 / p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (model, le) (rate(oath_llm_ttft_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (model, le) (rate(oath_llm_ttft_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool success rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(oath_tool_terminals_total{outcome=\"succeeded\"}[5m])) / clamp_min(sum by (tool) (rate(oath_tool_terminals_total[5m])), 0.000001)",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool duration p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (tool, le) (rate(oath_tool_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ ready messages",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rabbitmq_queue_messages_ready{queue=~\".*\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Gateway commands / second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type, channel, status) (rate(oath_gateway_commands_total[5m]))",
          "legendFormat": "{{type}} {{channel}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Delivery delay p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (type, le) (rate(oath_delivery_delay_seconds_bucket[5m])))",
          "legendFormat": "{{type}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["oath", "agent", "genai"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Oath overview",
  "timezone": "browser",
  "uid": "oath-overview",
  "version": 1
}
